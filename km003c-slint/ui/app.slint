import { ListView } from "std-widgets.slint";
import {
    FilterChip,
    IconButton,
    MaterialPalette,
    MaterialText,
    MaterialTypography,
    MaterialWindow,
    NavigationBar,
    SegmentedButton,
    TextButton,
} from "@material";
import { PlotWidget } from "@slint-realtime-plot/plot.slint";

// Re-exported so Rust can install the system's dynamic colours on Android.
export { MaterialPalette, MaterialScheme, MaterialSchemes } from "@material";

// Icons the Material library does not ship; see icons/README.md.
global AppIcons {
    out property <image> chart: @image-url("icons/show_chart.svg");
    out property <image> bolt: @image-url("icons/bolt.svg");
    out property <image> pause: @image-url("icons/pause.svg");
    out property <image> play: @image-url("icons/play_arrow.svg");
    out property <image> refresh: @image-url("icons/refresh.svg");
}

// One chart per quantity: they differ in units and range, so each has its own
// auto-ranged Y axis. Time window, pause and pan are shared.
component Chart inherits PlotWidget {
    min-height: 120px;
    vertical-stretch: 1;
    x-divisions: 5;
}

// A Material surface that sizes to its content; the library's cards fill
// their parent instead.
component Surface inherits Rectangle {
    background: MaterialPalette.surface_container_high;
    border-radius: 12px;
}

// One live reading: a label over a large coloured value.
component Readout inherits Surface {
    in property <string> label;
    in property <string> value;
    in property <color> accent;

    horizontal-stretch: 1;

    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        MaterialText {
            text: root.label;
            style: MaterialTypography.label_medium;
            color: MaterialPalette.on_surface_variant;
        }

        MaterialText {
            text: root.value;
            style: MaterialTypography.title_large;
            color: root.accent;
        }
    }
}

// One PD log entry, as produced by km003c_lib::PdLogger.
export struct PdRow {
    time: string,
    sop: string,
    title: string,
    header: string,
    details: string,
    // km003c_lib::PdLogCategory, in declaration order.
    category: int,
    good-crc: bool,
    expanded: bool,
}

global PdColors {
    // Readable on both light and dark backgrounds.
    public pure function category(category: int) -> color {
        if (category == 0) { return #22c55e; } // Connect
        if (category == 1) { return #ef4444; } // Disconnect
        if (category == 2) { return #3b82f6; } // Source capabilities
        if (category == 3) { return #eab308; } // Request
        if (category == 5) { return #f97316; } // Extended
        if (category == 6) { return #dc2626; } // Error
        return #9ca3af; // Control
    }
}

component PdRowView inherits Rectangle {
    in property <PdRow> entry;
    callback toggled();

    // ListView stacks rows by their height, so it has to follow the content.
    height: layout.preferred-height;

    layout := HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;

        Rectangle {
            width: 4px;
            border-radius: 2px;
            background: PdColors.category(root.entry.category);
        }

        VerticalLayout {
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                MaterialText {
                    text: root.entry.time;
                    style: MaterialTypography.label_small;
                    color: MaterialPalette.on_surface_variant;
                    vertical-alignment: center;
                }
                // Fixed width so titles line up whether or not there is a SOP.
                MaterialText {
                    text: root.entry.sop;
                    width: 36px;
                    style: MaterialTypography.label_small;
                    color: MaterialPalette.on_surface_variant;
                    vertical-alignment: center;
                }

                MaterialText {
                    text: root.entry.title;
                    style: MaterialTypography.title_small;
                    color: MaterialPalette.on_surface;
                    horizontal-stretch: 1;
                }
                // Drawn rather than typed: phone fonts lack the arrow glyphs.
                if root.entry.details != "": Path {
                    width: 10px;
                    height: 10px;
                    commands: root.entry.expanded ? "M 0 2 L 10 2 L 5 9 Z" : "M 2 0 L 9 5 L 2 10 Z";
                    fill: MaterialPalette.on_surface_variant;
                }
            }

            if root.entry.header != "": MaterialText {
                text: root.entry.header;
                style: MaterialTypography.label_small;
                color: MaterialPalette.on_surface_variant;
            }
            if root.entry.expanded && root.entry.details != "": MaterialText {
                text: root.entry.details;
                style: MaterialTypography.body_small;
                color: MaterialPalette.on_surface;
                wrap: word-wrap;
                overflow: clip;
            }
        }
    }

    // Separates rows from each other.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: MaterialPalette.outline_variant;
    }

    TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

export component App inherits MaterialWindow {
    // Per-chart render targets, read by Rust before each frame.
    out property <int> voltage-texture-width: voltage.requested-texture-width / 1phx;
    out property <int> voltage-texture-height: voltage.requested-texture-height / 1phx;
    out property <int> current-texture-width: current.requested-texture-width / 1phx;
    out property <int> current-texture-height: current.requested-texture-height / 1phx;
    out property <int> power-texture-width: power.requested-texture-width / 1phx;
    out property <int> power-texture-height: power.requested-texture-height / 1phx;

    in property <image> voltage-texture <=> voltage.texture;
    in property <image> current-texture <=> current.texture;
    in property <image> power-texture <=> power.texture;
    in property <float> voltage-y-min <=> voltage.y-min;
    in property <float> voltage-y-max <=> voltage.y-max;
    in property <int> voltage-y-divisions <=> voltage.y-divisions;
    in property <float> current-y-min <=> current.y-min;
    in property <float> current-y-max <=> current.y-max;
    in property <int> current-y-divisions <=> current.y-divisions;
    in property <float> power-y-min <=> power.y-min;
    in property <float> power-y-max <=> power.y-max;
    in property <int> power-y-divisions <=> power.y-divisions;

    in-out property <float> time-window: 10.0;
    in-out property <bool> paused: false;
    in-out property <int> view-offset: 0;
    in property <int> paused-shift: 0;
    in property <float> sample-rate: 50.0;
    in property <int> capacity: 262144;
    in property <int> available-samples: 0;
    out property <int> visible-samples: voltage.visible-samples;
    out property <int> effective-view-offset: voltage.effective-view-offset;

    in property <string> status: "Starting...";
    in property <string> device: "";
    in property <string> voltage-text: "—";
    in property <string> current-text: "—";
    in property <string> power-text: "—";
    in property <string> quality-text: "";

    // Index into the rate list: 2, 10, 50, 1000 SPS.
    in-out property <int> rate-index: 2;
    callback rate-selected(int);
    callback reconnect();

    // 0: charts, 1: PD.
    in-out property <int> tab: 0;

    // PD tab. Rows are oldest first, already filtered by pd-hide-good-crc.
    in property <[PdRow]> pd-rows;
    in-out property <bool> pd-hide-good-crc: true;
    callback pd-filter-changed(bool);
    in property <string> pd-sink: "—";
    in property <string> pd-lines: "—";
    in property <string> pd-contract: "—";
    callback pd-clear();
    callback pd-row-toggled(int);

    title: "POWER-Z KM003C";
    preferred-width: 900px;
    preferred-height: 800px;

    changed pd-hide-good-crc => {
        root.pd-filter-changed(root.pd-hide-good-crc);
    }

    VerticalLayout {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.right - root.safe-area-insets.left;
        // Runs to the bottom edge; a strip below the bottom bar fills the inset.
        height: root.height - root.safe-area-insets.top;

        // Compact top bar: the status lines take the place of an app title,
        // which saves a row of vertical space on a phone.
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 4px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 4px;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                MaterialText {
                    text: root.status;
                    style: MaterialTypography.title_medium;
                }

                MaterialText {
                    text: root.device;
                    style: MaterialTypography.body_small;
                    color: MaterialPalette.on_surface_variant;
                }
            }

            IconButton {
                icon: root.paused ? AppIcons.play : AppIcons.pause;
                tooltip: root.paused ? "Resume" : "Pause";
                clicked => {
                    root.paused = !root.paused;
                    if (!root.paused) {
                        root.view-offset = 0;
                    }
                }
            }

            IconButton {
                icon: AppIcons.refresh;
                tooltip: "Reconnect";
                clicked => {
                    root.reconnect();
                }
            }
        }

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 8px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;
                Readout {
                    label: "Voltage";
                    value: root.voltage-text;
                    accent: #16a34a;
                }

                Readout {
                    label: "Current";
                    value: root.current-text;
                    accent: #2563eb;
                }

                Readout {
                    label: "Power";
                    value: root.power-text;
                    accent: #d97706;
                }
            }

            SegmentedButton {
                items: [{ text: "2 SPS" }, { text: "10 SPS" }, { text: "50 SPS" }, { text: "1k SPS" }];
                current_index <=> root.rate-index;
                index_changed(index) => {
                    root.rate-selected(index);
                }
            }
        }

        // Both pages stay laid out, so the charts keep their texture size
        // while hidden; only the visible one draws and takes input.
        Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                visible: root.tab == 0;
                width: parent.width;
                height: parent.height;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;

                voltage := Chart {
                    title: "Voltage (V)";
                    legend-labels: ["VBUS"];
                    legend-colors: [#22c55e];
                    time-window <=> root.time-window;
                    paused <=> root.paused;
                    view-offset <=> root.view-offset;
                    paused-shift: root.paused-shift;
                    sample-rate: root.sample-rate;
                    capacity: root.capacity;
                    max-time-window: root.capacity / root.sample-rate;
                    available-samples: root.available-samples;
                }

                current := Chart {
                    title: "Current (A)";
                    legend-labels: ["IBUS"];
                    legend-colors: [#3b82f6];
                    time-window <=> root.time-window;
                    paused <=> root.paused;
                    view-offset <=> root.view-offset;
                    paused-shift: root.paused-shift;
                    sample-rate: root.sample-rate;
                    capacity: root.capacity;
                    max-time-window: root.capacity / root.sample-rate;
                    available-samples: root.available-samples;
                }

                power := Chart {
                    title: "Power (W)";
                    legend-labels: ["Power"];
                    legend-colors: [#f59e0b];
                    time-window <=> root.time-window;
                    paused <=> root.paused;
                    view-offset <=> root.view-offset;
                    paused-shift: root.paused-shift;
                    sample-rate: root.sample-rate;
                    capacity: root.capacity;
                    max-time-window: root.capacity / root.sample-rate;
                    available-samples: root.available-samples;
                }

                MaterialText {
                    text: root.quality-text;
                    style: MaterialTypography.label_small;
                    color: MaterialPalette.on_surface_variant;
                }
            }

            VerticalLayout {
                visible: root.tab == 1;
                width: parent.width;
                height: parent.height;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 8px;

                Surface {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        MaterialText {
                            text: root.pd-sink;
                            style: MaterialTypography.title_medium;
                        }

                        MaterialText {
                            text: root.pd-lines;
                            style: MaterialTypography.body_small;
                            color: MaterialPalette.on_surface_variant;
                        }

                        MaterialText {
                            text: "Contract: " + root.pd-contract;
                            style: MaterialTypography.body_medium;
                            wrap: word-wrap;
                            overflow: clip;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;
                    FilterChip {
                        text: "Hide GoodCRC";
                        checked <=> root.pd-hide-good-crc;
                    }

                    TextButton {
                        text: "Clear";
                        clicked => {
                            root.pd-clear();
                        }
                    }
                }

                ListView {
                    // Follow new rows while scrolled to the end; stay put
                    // while reading older ones.
                    property <bool> follow: true;
                    property <length> end-y: min(0px, self.visible-height - self.content-height);

                    vertical-stretch: 1;
                    changed content-y => {
                        self.follow = self.content-y <= self.end-y + 24px;
                    }
                    changed content-height => {
                        if (self.follow) {
                            self.content-y = self.end-y;
                        }
                    }

                    for row[index] in root.pd-rows: PdRowView {
                        entry: row;
                        toggled => {
                            root.pd-row-toggled(index);
                        }
                    }
                }
            }
        }

        NavigationBar {
            items: [
                { icon: AppIcons.chart, selected_icon: AppIcons.chart, text: "Charts" },
                { icon: AppIcons.bolt, selected_icon: AppIcons.bolt, text: "PD" },
            ];
            current_index <=> root.tab;
        }

        // Edge to edge: the bar's surface continues under the system
        // navigation, in the bar's own colour.
        Rectangle {
            height: root.safe-area-insets.bottom;
            background: MaterialPalette.surface_container;
        }
    }
}
