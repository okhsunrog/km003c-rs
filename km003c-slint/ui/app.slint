import { ListView, Palette } from "std-widgets.slint";
import {
    FilledButton,
    FilterChip,
    IconButton,
    MaterialPalette,
    MaterialText,
    MaterialTypography,
    MaterialWindow,
    NavigationBar,
    NavigationRail,
    ScrollView,
    SegmentedButton,
    SecondaryTabBar,
    TextButton,
    TonalButton,
} from "@material";
import { PlotWidget } from "@slint-realtime-plot/plot.slint";

// Re-exported so Rust can install the system's dynamic colours on Android.
export { Palette } from "std-widgets.slint";
export { MaterialPalette, MaterialScheme, MaterialSchemes } from "@material";

// Icons the Material library does not ship; see icons/README.md.
global AppIcons {
    out property <image> chart: @image-url("icons/show_chart.svg");
    out property <image> bolt: @image-url("icons/bolt.svg");
    out property <image> pause: @image-url("icons/pause.svg");
    out property <image> play: @image-url("icons/play_arrow.svg");
    out property <image> refresh: @image-url("icons/refresh.svg");
    out property <image> record: @image-url("icons/fiber_manual_record.svg");
    out property <image> stop: @image-url("icons/stop.svg");
    out property <image> folder: @image-url("icons/folder.svg");
}

global DataColors {
    out property <bool> dark: Palette.background.to-hsv().value < 0.5;
    out property <color> voltage: root.dark ? #53da8f : #007543;
    out property <color> current: root.dark ? #6dadff : #1f5bc2;
    out property <color> power: root.dark ? #ffc06a : #9d4f00;
}

// Dims its content and swallows its input while disabled, for components such
// as SegmentedButton that have no enabled property.
component Disableable inherits Rectangle {
    in property <bool> enabled: true;

    min-height: content.min-height;
    preferred-height: content.preferred-height;
    opacity: root.enabled ? 1 : 0.38;

    content := VerticalLayout {
        @children
    }

    if !root.enabled: TouchArea { }
}

// One chart per quantity: they differ in units and range, so each has its own
// auto-ranged Y axis. Time window, pause and pan are shared.
component Chart inherits PlotWidget {
    in property <bool> shown: true;
    visible: root.shown;
    min-height: root.shown ? 120px : 0px;
    max-height: root.shown ? 100000px : 0px;
    preferred-height: root.shown ? 180px : 0px;
    vertical-stretch: root.shown ? 1 : 0;
    show-controls: false;
    x-divisions: 5;
}

// A Material surface that sizes to its content; the library's cards fill
// their parent instead.
component Surface inherits Rectangle {
    background: MaterialPalette.surface_container_high;
    border-radius: 12px;
}

// One live reading: a label over a large coloured value.
component Readout inherits Surface {
    in property <string> label;
    in property <string> value;
    in property <string> unit;
    in property <color> accent;
    in property <bool> live;
    horizontal-stretch: 1;
    min-width: 0px;
    min-height: 64px;
    preferred-height: 72px;
    max-height: 80px;
    VerticalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        padding: 8px;
        spacing: 4px;
        HorizontalLayout {
            MaterialText {
                text: root.label;
                style: MaterialTypography.label_medium;
                color: MaterialPalette.on_surface_variant;
            }

            MaterialText {
                text: root.unit;
                style: MaterialTypography.label_medium;
                color: MaterialPalette.on_surface_variant;
                horizontal-alignment: right;
            }
        }

        Text {
            text: root.value;
            font-family: "monospace";
            font-size: clamp((root.width - 16px) / 5, 14px, 32px);
            font-weight: 600;
            color: root.live ? root.accent : MaterialPalette.on_surface_variant;
            overflow: clip;
            wrap: no-wrap;
        }
    }
}

// One PD log entry, as produced by km003c_lib::PdLogger.
export struct PdRow {
    time: string,
    sop: string,
    title: string,
    header: string,
    details: string,
    // km003c_lib::PdLogCategory, in declaration order.
    category: int,
    good-crc: bool,
    expanded: bool,
}

global PdColors {
    // Readable on both light and dark backgrounds.
    public pure function category(category: int) -> color {
        if (category == 0) { return #22c55e; } // Connect
        if (category == 1) { return #ef4444; } // Disconnect
        if (category == 2) { return #3b82f6; } // Source capabilities
        if (category == 3) { return #eab308; } // Request
        if (category == 5) { return #f97316; } // Extended
        if (category == 6) { return #dc2626; } // Error
        if (category == 7) { return #06b6d4; } // Firmware trace
        if (category == 8) { return #a16207; } // Unknown firmware trace code
        return #9ca3af; // Control
    }
}

// One recording in the meter's own memory.
export struct OfflineRow {
    name: string,
    detail: string,
}

component OfflineRowView inherits Rectangle {
    in property <OfflineRow> entry;
    in property <bool> enabled;
    callback export();

    height: layout.preferred-height;

    layout := HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            MaterialText {
                text: root.entry.name;
                style: MaterialTypography.title_small;
                color: MaterialPalette.on_surface;
            }

            MaterialText {
                text: root.entry.detail;
                style: MaterialTypography.body_small;
                color: MaterialPalette.on_surface_variant;
                wrap: word-wrap;
            }
        }

        TonalButton {
            text: "Export";
            enabled: root.enabled;
            clicked => {
                root.export();
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: MaterialPalette.outline_variant;
    }
}

component PdRowView inherits Rectangle {
    in property <PdRow> entry;
    callback toggled();

    // ListView stacks rows by their height, so it has to follow the content.
    height: layout.preferred-height;

    layout := HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;

        Rectangle {
            width: 4px;
            border-radius: 2px;
            background: PdColors.category(root.entry.category);
        }

        VerticalLayout {
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                MaterialText {
                    text: root.entry.time;
                    style: MaterialTypography.label_small;
                    color: MaterialPalette.on_surface_variant;
                    vertical-alignment: center;
                }
                // Fixed width so titles line up whether or not there is a SOP.
                MaterialText {
                    text: root.entry.sop;
                    width: 36px;
                    style: MaterialTypography.label_small;
                    color: MaterialPalette.on_surface_variant;
                    vertical-alignment: center;
                }

                MaterialText {
                    text: root.entry.title;
                    style: MaterialTypography.title_small;
                    color: MaterialPalette.on_surface;
                    horizontal-stretch: 1;
                }
                // Drawn rather than typed: phone fonts lack the arrow glyphs.
                if root.entry.details != "": Path {
                    width: 10px;
                    height: 10px;
                    commands: root.entry.expanded ? "M 0 2 L 10 2 L 5 9 Z" : "M 2 0 L 9 5 L 2 10 Z";
                    fill: MaterialPalette.on_surface_variant;
                }
            }

            if root.entry.header != "": MaterialText {
                text: root.entry.header;
                style: MaterialTypography.label_small;
                color: MaterialPalette.on_surface_variant;
            }
            if root.entry.expanded && root.entry.details != "": MaterialText {
                text: root.entry.details;
                style: MaterialTypography.body_small;
                color: MaterialPalette.on_surface;
                wrap: word-wrap;
                overflow: clip;
            }
        }
    }

    // Separates rows from each other.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: MaterialPalette.outline_variant;
    }

    TouchArea {
        clicked => {
            root.toggled();
        }
    }
}

export component App inherits MaterialWindow {
    // Per-chart render targets, read by Rust before each frame.
    out property <int> voltage-texture-width: voltage.requested-texture-width / 1phx;
    out property <int> voltage-texture-height: voltage.requested-texture-height / 1phx;
    out property <int> current-texture-width: current.requested-texture-width / 1phx;
    out property <int> current-texture-height: current.requested-texture-height / 1phx;
    out property <int> power-texture-width: power.requested-texture-width / 1phx;
    out property <int> power-texture-height: power.requested-texture-height / 1phx;

    in property <image> voltage-texture <=> voltage.texture;
    in property <image> current-texture <=> current.texture;
    in property <image> power-texture <=> power.texture;
    in property <float> voltage-y-min <=> voltage.y-min;
    in property <float> voltage-y-max <=> voltage.y-max;
    in property <int> voltage-y-divisions <=> voltage.y-divisions;
    in property <float> current-y-min <=> current.y-min;
    in property <float> current-y-max <=> current.y-max;
    in property <int> current-y-divisions <=> current.y-divisions;
    in property <float> power-y-min <=> power.y-min;
    in property <float> power-y-max <=> power.y-max;
    in property <int> power-y-divisions <=> power.y-divisions;

    in-out property <float> time-window: 10.0;
    in-out property <bool> paused: false;
    in-out property <int> view-offset: 0;
    in property <int> paused-shift: 0;
    in property <float> sample-rate: 50.0;
    in property <int> capacity: 262144;
    in property <int> available-samples: 0;
    out property <int> visible-samples: voltage.visible-samples;
    out property <int> effective-view-offset: voltage.effective-view-offset;

    in property <string> status: "Starting...";
    in property <string> device: "";
    in property <string> voltage-text: "—";
    in property <string> current-text: "—";
    in property <string> power-text: "—";
    in property <string> quality-text: "";

    // Index into the rate list: 2, 10, 50, 1000 SPS.
    in-out property <int> rate-index: 2;
    callback rate-selected(int);
    callback reconnect();

    // 0: charts, 1: PD, 2: files.
    in-out property <int> tab: 0;
    in-out property <int> focused-chart: -1;
    private property <int> effective-focus: root.focused-chart < 0 && root.height < 520px ? 0 : root.focused-chart;
    private property <bool> wide: root.width >= 1100px;
    in-out property <int> theme-index: 0;
    in-out property <bool> measurement-live: false;
    in property <bool> has-reading: false;
    in-out property <float> sample-age-seconds: 0;
    out property <string> reading-age: root.sample-age-seconds.to-fixed(1) + " s ago";
    out property <color> voltage-color: DataColors.voltage;
    out property <color> current-color: DataColors.current;
    out property <color> power-color: DataColors.power;
    in-out property <int> recording-seconds: 0;

    changed theme-index => {
        Palette.color-scheme = root.theme-index == 1 ? ColorScheme.light : root.theme-index == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }
    changed recording => { if root.recording { root.recording-seconds = 0; } }

    Timer {
        interval: 500ms;
        running: root.has-reading;
        triggered => {
            root.sample-age-seconds += 0.5;
            if root.sample-age-seconds >= 2 { root.measurement-live = false; }
        }
    }

    // PD tab. Rows are oldest first, already filtered by pd-hide-good-crc.
    in property <[PdRow]> pd-rows;
    in-out property <bool> pd-hide-good-crc: true;
    callback pd-filter-changed(bool);
    in-out property <bool> pd-trace-enabled: false;
    callback pd-trace-changed(bool);
    in property <string> pd-sink: "—";
    in property <string> pd-lines: "—";
    in property <string> pd-contract: "—";
    callback pd-clear();
    callback pd-row-toggled(int);

    // Files tab: the live capture.
    in property <bool> recording: false;
    // 0: Parquet, 1: CSV.
    in-out property <int> recording-format-index: 0;
    callback recording-format-selected(int);
    callback start-recording();
    callback stop-recording();
    in property <string> recording-progress: "";
    in property <string> recording-status: "";
    in property <string> recordings-dir: "";

    // Files tab: recordings stored on the meter.
    in property <[OfflineRow]> offline-rows;
    in property <bool> offline-busy: false;
    in property <string> offline-status: "Not loaded";
    callback offline-load();
    callback offline-export(int);

    title: "POWER-Z KM003C";
    icon: @image-url("../../assets/km003c-logo.svg");
    min-width: 280px;
    min-height: 240px;
    preferred-width: 1000px;
    preferred-height: 800px;

    changed pd-hide-good-crc => {
        root.pd-filter-changed(root.pd-hide-good-crc);
    }
    changed pd-trace-enabled => {
        root.pd-trace-changed(root.pd-trace-enabled);
    }

    HorizontalLayout {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.right - root.safe-area-insets.left;
        // Runs to the bottom edge; a strip below the bottom bar fills the inset.
        height: root.height - root.safe-area-insets.top;

        if root.wide: NavigationRail {
            width: 88px;
            alignment: start;
            items: [
                { icon: AppIcons.chart, selected_icon: AppIcons.chart, text: "Charts" },
                { icon: AppIcons.bolt, selected_icon: AppIcons.bolt, text: "PD" },
                { icon: AppIcons.folder, selected_icon: AppIcons.folder, text: "Files" },
            ];
            current_index <=> root.tab;
        }
        VerticalLayout {
            min-width: 0px;
            // The status replaces an app title to save a row on a phone.
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 4px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 4px;

                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    MaterialText {
                        text: root.status;
                        style: MaterialTypography.title_medium;
                    }

                    MaterialText {
                        text: root.device;
                        style: MaterialTypography.body_small;
                        color: MaterialPalette.on_surface_variant;
                    }
                }

                view-button := TextButton {
                    text: "View";
                    clicked => { view-menu.show(); }
                }

                if root.recording: MaterialText {
                    text: "REC " + root.recording-seconds + " s";
                    style: MaterialTypography.label_medium;
                    color: MaterialPalette.error;
                    vertical-alignment: center;
                }
                // Recording goes on whichever tab is open.
                IconButton {
                    icon: root.recording ? AppIcons.stop : AppIcons.record;
                    tooltip: root.recording ? "Stop recording" : "Start recording";
                    has_error: root.recording;
                    clicked => {
                        if (root.recording) {
                            root.stop-recording();
                        } else {
                            root.start-recording();
                        }
                    }
                }

                IconButton {
                    icon: AppIcons.refresh;
                    tooltip: "Reconnect";
                    clicked => {
                        root.reconnect();
                    }
                }
            }

            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 8px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    Readout {
                        label: "Voltage";
                        value: root.voltage-text;
                        unit: "V";
                        live: root.measurement-live;
                        accent: DataColors.voltage;
                    }

                    Readout {
                        label: "Current ±";
                        value: root.current-text;
                        unit: "A";
                        live: root.measurement-live;
                        accent: DataColors.current;
                    }

                    Readout {
                        label: "Power ±";
                        value: root.power-text;
                        unit: "W";
                        live: root.measurement-live;
                        accent: DataColors.power;
                    }
                }
            }

            if !root.measurement-live: MaterialText {
                text: root.has-reading ? "Last reading · " + root.reading-age : "Waiting for the first measurement";
                style: MaterialTypography.label_medium;
                color: MaterialPalette.on_surface_variant;
            }

            // Pages remain instantiated, keeping the chart handles stable.
            // Only the visible page draws and takes input.
            Rectangle {
                vertical-stretch: 1;
                min-height: 0px;
                clip: true;

                page-0 := ScrollView {
                    visible: root.tab == 0;
                    width: parent.width;
                    height: parent.height;
                    horizontal_scrollbar_policy: ScrollBarPolicy.always_off;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, page-content-0.min-height);
                    page-content-0 := VerticalLayout {
                        x: (parent.content-width - self.width) / 2;
                        width: parent.content-width;
                        height: parent.content-height;
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;

                        // The rate only matters for the charts. A recording keeps
                        // one rate from start to end.
                        if root.height >= 520px: Disableable {
                            enabled: !root.recording;
                            SegmentedButton {
                                items: [{ text: "2 SPS" }, { text: "10 SPS" }, { text: "50 SPS" }, { text: "1k SPS" }];
                                current_index <=> root.rate-index;
                                index_changed(index) => {
                                    root.rate-selected(index);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            if root.height >= 520px: FilterChip {
                                toggle-on-click: false;
                                text: "All";
                                checked: root.effective-focus < 0;
                                clicked => { root.focused-chart = -1; }
                            }
                            for name[index] in ["V", "A", "W"]: FilterChip {
                                toggle-on-click: false;
                                text: name;
                                checked: root.effective-focus == index;
                                clicked => { root.focused-chart = index; }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            TextButton {
                                text: root.paused ? "Resume view" : "Pause view";
                                clicked => { root.paused = !root.paused; }
                            }

                            TextButton {
                                text: "Live";
                                clicked => { root.paused = false; root.view-offset = 0; }
                            }

                            TextButton {
                                text: "+";
                                clicked => { root.time-window = max(2 / root.sample-rate, root.time-window * 0.8); }
                            }

                            TextButton {
                                text: "−";
                                clicked => { root.time-window = min(root.capacity / root.sample-rate, root.time-window * 1.25); }
                            }
                        }

                        voltage := Chart {
                            wheel-zoom-enabled: page-0.content-height <= page-0.visible-height;
                            shown: root.effective-focus < 0 || root.effective-focus == 0;
                            title: "Voltage (V)";
                            title-color: DataColors.voltage;
                            show-time-axis: root.effective-focus == 0;
                            time-window <=> root.time-window;
                            paused <=> root.paused;
                            view-offset <=> root.view-offset;
                            paused-shift: root.paused-shift;
                            sample-rate: root.sample-rate;
                            capacity: root.capacity;
                            max-time-window: root.capacity / root.sample-rate;
                            available-samples: root.available-samples;
                        }

                        current := Chart {
                            wheel-zoom-enabled: page-0.content-height <= page-0.visible-height;
                            shown: root.effective-focus < 0 || root.effective-focus == 1;
                            title: "Current (A, signed)";
                            title-color: DataColors.current;
                            show-time-axis: root.effective-focus == 1;
                            time-window <=> root.time-window;
                            paused <=> root.paused;
                            view-offset <=> root.view-offset;
                            paused-shift: root.paused-shift;
                            sample-rate: root.sample-rate;
                            capacity: root.capacity;
                            max-time-window: root.capacity / root.sample-rate;
                            available-samples: root.available-samples;
                        }

                        power := Chart {
                            wheel-zoom-enabled: page-0.content-height <= page-0.visible-height;
                            shown: root.effective-focus < 0 || root.effective-focus == 2;
                            title: "Power (W, signed)";
                            title-color: DataColors.power;
                            time-window <=> root.time-window;
                            paused <=> root.paused;
                            view-offset <=> root.view-offset;
                            paused-shift: root.paused-shift;
                            sample-rate: root.sample-rate;
                            capacity: root.capacity;
                            max-time-window: root.capacity / root.sample-rate;
                            available-samples: root.available-samples;
                        }

                        MaterialText {
                            text: root.quality-text;
                            style: MaterialTypography.label_small;
                            color: MaterialPalette.on_surface_variant;
                        }
                    }
                }

                page-1 := ScrollView {
                    visible: root.tab == 1;
                    width: parent.width;
                    height: parent.height;
                    horizontal_scrollbar_policy: ScrollBarPolicy.always_off;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, page-content-1.min-height);
                    page-content-1 := VerticalLayout {
                        x: (parent.content-width - self.width) / 2;
                        width: min(parent.content-width, 960px);
                        height: parent.content-height;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;

                        Surface {
                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                MaterialText {
                                    text: root.pd-sink;
                                    style: MaterialTypography.title_medium;
                                }

                                MaterialText {
                                    text: root.pd-lines;
                                    style: MaterialTypography.body_small;
                                    color: MaterialPalette.on_surface_variant;
                                }

                                MaterialText {
                                    text: "Contract: " + root.pd-contract;
                                    style: MaterialTypography.body_medium;
                                    wrap: word-wrap;
                                    overflow: clip;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 8px;
                                FilterChip {
                                    text: "Hide GoodCRC";
                                    checked <=> root.pd-hide-good-crc;
                                }

                                FilterChip {
                                    text: "Firmware trace";
                                    tooltip: "Also read the Type-C and protocol-engine trace of the KM003C firmware";
                                    checked <=> root.pd-trace-enabled;
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            TextButton {
                                text: "Clear";
                                clicked => {
                                    root.pd-clear();
                                }
                            }
                        }

                        ListView {
                            min-height: 120px;
                    // Follow new rows while scrolled to the end; stay put
                    // while reading older ones.
                    property <bool> follow: true;
                            property <length> end-y: min(0px, self.visible-height - self.content-height);

                            vertical-stretch: 1;
                            changed content-y => {
                                self.follow = self.content-y <= self.end-y + 24px;
                            }
                            changed content-height => {
                                if (self.follow) {
                                    self.content-y = self.end-y;
                                }
                            }

                            for row[index] in root.pd-rows: PdRowView {
                                entry: row;
                                toggled => {
                                    root.pd-row-toggled(index);
                                }
                            }
                        }
                    }
                }

                page-2 := ScrollView {
                    visible: root.tab == 2;
                    width: parent.width;
                    height: parent.height;
                    horizontal_scrollbar_policy: ScrollBarPolicy.always_off;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, page-content-2.min-height);
                    page-content-2 := VerticalLayout {
                        x: (parent.content-width - self.width) / 2;
                        width: min(parent.content-width, 960px);
                        height: parent.content-height;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;

                        Surface {
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;
                                MaterialText {
                                    text: "Live recording";
                                    style: MaterialTypography.title_medium;
                                }

                                Disableable {
                                    enabled: !root.recording;
                                    SegmentedButton {
                                        items: [{ text: "Parquet" }, { text: "CSV" }];
                                        current_index <=> root.recording-format-index;
                                        index_changed(index) => {
                                            root.recording-format-selected(index);
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    alignment: start;
                                    FilledButton {
                                        text: root.recording ? "Stop recording" : "Start recording";
                                        icon: root.recording ? AppIcons.stop : AppIcons.record;
                                        clicked => {
                                            if (root.recording) {
                                                root.stop-recording();
                                            } else {
                                                root.start-recording();
                                            }
                                        }
                                    }
                                }

                                if root.recording-progress != "": MaterialText {
                                    text: root.recording-progress;
                                    style: MaterialTypography.body_medium;
                                }
                                if root.recording-status != "": MaterialText {
                                    text: root.recording-status;
                                    style: MaterialTypography.body_small;
                                    color: MaterialPalette.on_surface_variant;
                                    wrap: word-wrap;
                                }
                                MaterialText {
                                    text: "Saved to " + root.recordings-dir;
                                    style: MaterialTypography.label_small;
                                    color: MaterialPalette.on_surface_variant;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                MaterialText {
                                    text: "Stored on the meter";
                                    style: MaterialTypography.title_medium;
                                }

                                MaterialText {
                                    text: root.offline-status;
                                    style: MaterialTypography.body_small;
                                    color: MaterialPalette.on_surface_variant;
                                    wrap: word-wrap;
                                }
                            }

                            TextButton {
                                text: "Load";
                        // Loading pauses the live stream, which a recording
                        // cannot have.
                        enabled: !root.offline-busy && !root.recording;
                                clicked => {
                                    root.offline-load();
                                }
                            }
                        }

                        ListView {
                            min-height: 120px;
                            vertical-stretch: 1;
                            for row[index] in root.offline-rows: OfflineRowView {
                                entry: row;
                                enabled: !root.offline-busy && !root.recording;
                                export => {
                                    root.offline-export(index);
                                }
                            }
                        }
                    }
                }
            }

            if !root.wide && root.height >= 520px: NavigationBar {
                items: [
                    { icon: AppIcons.chart, selected_icon: AppIcons.chart, text: "Charts" },
                    { icon: AppIcons.bolt, selected_icon: AppIcons.bolt, text: "PD" },
                    { icon: AppIcons.folder, selected_icon: AppIcons.folder, text: "Files" },
                ];
                current_index <=> root.tab;
            }
            if !root.wide && root.height < 520px: SecondaryTabBar {
                items: [{ text: "Charts" }, { text: "PD" }, { text: "Files" }];
                current_index <=> root.tab;
            }

            // Edge to edge: the bar's surface continues under the system
            // navigation, in the bar's own colour.
            Rectangle {
                height: root.safe-area-insets.bottom;
                background: MaterialPalette.surface_container;
            }
        }
    }

    view-menu := PopupWindow {
        x: max(8px, min(root.width - self.width - 8px, view-button.absolute-position.x));
        y: view-button.absolute-position.y + view-button.height;
        width: min(root.width - 16px, 300px);
        height: view-menu-content.preferred-height;
        Rectangle {
            background: MaterialPalette.surface_container_high;
            border-radius: 12px;
        }

        view-menu-content := VerticalLayout {
            padding: 12px;
            spacing: 8px;
            MaterialText {
                text: "Appearance";
                style: MaterialTypography.title_medium;
            }

            for name[index] in ["System", "Light", "Dark"]: FilterChip {
                toggle-on-click: false;
                text: name;
                checked: root.theme-index == index;
                clicked => { root.theme-index = index; }
            }
            if root.height < 520px: MaterialText {
                text: "Sample rate";
                style: MaterialTypography.title_medium;
            }
            if root.height < 520px: Disableable {
                enabled: !root.recording;
                SegmentedButton {
                    items: [{ text: "2" }, { text: "10" }, { text: "50" }, { text: "1k" }];
                    current_index <=> root.rate-index;
                    index_changed(index) => { root.rate-selected(index); }
                }
            }
        }
    }
}
