import {
    Button,
    CheckBox,
    ComboBox,
    HorizontalBox,
    ListView,
    Palette,
    VerticalBox,
} from "std-widgets.slint";
import { PlotWidget } from "@slint-realtime-plot/plot.slint";

// One chart per quantity: they differ in units and range, so each has its own
// auto-ranged Y axis. Time window, pause and pan are shared.
component Chart inherits PlotWidget {
    min-height: 120px;
    vertical-stretch: 1;
    x-divisions: 5;
}

// One PD log entry, as produced by km003c_lib::PdLogger.
export struct PdRow {
    time: string,
    sop: string,
    title: string,
    header: string,
    details: string,
    // km003c_lib::PdLogCategory, in declaration order.
    category: int,
    good-crc: bool,
    expanded: bool,
}

global PdColors {
    // Readable on both light and dark backgrounds.
    public pure function category(category: int) -> color {
        if (category == 0) { return #22c55e; } // Connect
        if (category == 1) { return #ef4444; } // Disconnect
        if (category == 2) { return #3b82f6; } // Source capabilities
        if (category == 3) { return #eab308; } // Request
        if (category == 5) { return #f97316; } // Extended
        if (category == 6) { return #dc2626; } // Error
        return #9ca3af; // Control
    }
}

component PdRowView inherits Rectangle {
    in property <PdRow> entry;
    callback toggled();

    // ListView stacks rows by their height, so it has to follow the content.
    height: layout.preferred-height;

    layout := HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 6px;

        Rectangle {
            width: 4px;
            background: PdColors.category(root.entry.category);
        }

        VerticalLayout {
            spacing: 1px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.entry.time;
                    font-size: 11px;
                    opacity: 0.6;
                    vertical-alignment: center;
                }
                // Fixed width so titles line up whether or not there is a SOP.
                Text {
                    text: root.entry.sop;
                    width: 36px;
                    font-size: 11px;
                    opacity: 0.6;
                    vertical-alignment: center;
                }

                Text {
                    text: root.entry.title;
                    font-weight: 600;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                // Drawn rather than typed: phone fonts lack the arrow glyphs.
                if root.entry.details != "": Path {
                    width: 10px;
                    height: 10px;
                    commands: root.entry.expanded ? "M 0 2 L 10 2 L 5 9 Z" : "M 2 0 L 9 5 L 2 10 Z";
                    fill: Palette.foreground;
                    opacity: 0.5;
                }
            }

            if root.entry.header != "": Text {
                text: root.entry.header;
                font-size: 11px;
                opacity: 0.6;
            }
            if root.entry.expanded && root.entry.details != "": Text {
                text: root.entry.details;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }

    // Separates rows from each other.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Palette.border;
    }

    TouchArea {
        clicked => { root.toggled(); }
    }
}

// One segment of the tab switcher.
component Segment inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();

    border-radius: 7px;
    background: root.selected ? Palette.accent-background : touch.pressed ? Palette.border : transparent;
    animate background { duration: 120ms; }

    Text {
        text: root.text;
        font-size: 15px;
        font-weight: 600;
        color: root.selected ? Palette.accent-foreground : Palette.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Segmented tab switcher. Every segment sits on a shared framed track, so the
// unselected one reads as a button too; the stock TabWidget left it looking
// like plain text on light themes.
component TabSwitcher inherits Rectangle {
    in-out property <int> current;
    in property <[string]> labels;

    height: 42px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Palette.border;
    background: Palette.alternate-background;

    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for label[index] in root.labels: Segment {
            text: label;
            selected: root.current == index;
            clicked => { root.current = index; }
        }
    }
}

export component App inherits Window {
    // Per-chart render targets, read by Rust before each frame.
    out property <int> voltage-texture-width: voltage.requested-texture-width / 1phx;
    out property <int> voltage-texture-height: voltage.requested-texture-height / 1phx;
    out property <int> current-texture-width: current.requested-texture-width / 1phx;
    out property <int> current-texture-height: current.requested-texture-height / 1phx;
    out property <int> power-texture-width: power.requested-texture-width / 1phx;
    out property <int> power-texture-height: power.requested-texture-height / 1phx;

    in property <image> voltage-texture <=> voltage.texture;
    in property <image> current-texture <=> current.texture;
    in property <image> power-texture <=> power.texture;
    in property <float> voltage-y-min <=> voltage.y-min;
    in property <float> voltage-y-max <=> voltage.y-max;
    in property <int> voltage-y-divisions <=> voltage.y-divisions;
    in property <float> current-y-min <=> current.y-min;
    in property <float> current-y-max <=> current.y-max;
    in property <int> current-y-divisions <=> current.y-divisions;
    in property <float> power-y-min <=> power.y-min;
    in property <float> power-y-max <=> power.y-max;
    in property <int> power-y-divisions <=> power.y-divisions;

    in-out property <float> time-window: 10.0;
    in-out property <bool> paused: false;
    in-out property <int> view-offset: 0;
    in property <int> paused-shift: 0;
    in property <float> sample-rate: 50.0;
    in property <int> capacity: 262144;
    in property <int> available-samples: 0;
    out property <int> visible-samples: voltage.visible-samples;
    out property <int> effective-view-offset: voltage.effective-view-offset;

    in property <string> status: "Starting...";
    in property <string> device: "";
    in property <string> voltage-text: "—";
    in property <string> current-text: "—";
    in property <string> power-text: "—";
    in property <string> quality-text: "";

    // Index into the rate list: 2, 10, 50, 1000 SPS.
    in-out property <int> rate-index: 2;
    callback rate-selected(int);
    callback reconnect();

    // 0: charts, 1: PD.
    in-out property <int> tab: 0;

    // PD tab. Rows are newest first, already filtered by pd-hide-good-crc.
    in property <[PdRow]> pd-rows;
    in-out property <bool> pd-hide-good-crc: true;
    callback pd-filter-changed(bool);
    in property <string> pd-sink: "—";
    in property <string> pd-lines: "—";
    in property <string> pd-contract: "—";
    callback pd-clear();
    callback pd-row-toggled(int);

    title: "POWER-Z KM003C";
    preferred-width: 900px;
    preferred-height: 800px;

    VerticalBox {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.right - root.safe-area-insets.left;
        height: root.height - root.safe-area-insets.bottom - root.safe-area-insets.top;

        VerticalLayout {
            Text {
                text: root.status;
                font-weight: 600;
            }

            Text {
                text: root.device;
                opacity: 0.7;
            }
        }

        // Controls get their own row so they fit a phone in portrait.
        HorizontalBox {
            padding: 0;
            ComboBox {
                horizontal-stretch: 1;
                model: ["2 SPS", "10 SPS", "50 SPS", "1000 SPS"];
                current-index <=> root.rate-index;
                selected => { root.rate-selected(self.current-index); }
            }

            Button {
                text: root.paused ? "Resume" : "Pause";
                clicked => {
                    root.paused = !root.paused;
                    if (!root.paused) {
                        root.view-offset = 0;
                    }
                }
            }

            Button {
                text: "Reconnect";
                clicked => { root.reconnect(); }
            }
        }

        HorizontalBox {
            padding: 0;
            alignment: space-around;
            Text {
                text: root.voltage-text;
                font-size: 22px;
                color: #22c55e;
            }

            Text {
                text: root.current-text;
                font-size: 22px;
                color: #3b82f6;
            }

            Text {
                text: root.power-text;
                font-size: 22px;
                color: #f59e0b;
            }
        }

        TabSwitcher {
            labels: ["Charts", "PD"];
            current <=> root.tab;
        }

        // Both pages stay laid out, so the charts keep their texture size
        // while hidden; only the visible one draws and takes input.
        Rectangle {
            vertical-stretch: 1;

            VerticalLayout {
                visible: root.tab == 0;
                width: parent.width;
                height: parent.height;
                spacing: 6px;

                voltage := Chart {
                    title: "Voltage (V)";
                    legend-labels: ["VBUS"];
                    legend-colors: [#22c55e];
                    time-window <=> root.time-window;
                    paused <=> root.paused;
                    view-offset <=> root.view-offset;
                    paused-shift: root.paused-shift;
                    sample-rate: root.sample-rate;
                    capacity: root.capacity;
                    max-time-window: root.capacity / root.sample-rate;
                    available-samples: root.available-samples;
                }

                current := Chart {
                    title: "Current (A)";
                    legend-labels: ["IBUS"];
                    legend-colors: [#3b82f6];
                    time-window <=> root.time-window;
                    paused <=> root.paused;
                    view-offset <=> root.view-offset;
                    paused-shift: root.paused-shift;
                    sample-rate: root.sample-rate;
                    capacity: root.capacity;
                    max-time-window: root.capacity / root.sample-rate;
                    available-samples: root.available-samples;
                }

                power := Chart {
                    title: "Power (W)";
                    legend-labels: ["Power"];
                    legend-colors: [#f59e0b];
                    time-window <=> root.time-window;
                    paused <=> root.paused;
                    view-offset <=> root.view-offset;
                    paused-shift: root.paused-shift;
                    sample-rate: root.sample-rate;
                    capacity: root.capacity;
                    max-time-window: root.capacity / root.sample-rate;
                    available-samples: root.available-samples;
                }

                Text {
                    text: root.quality-text;
                    opacity: 0.6;
                    font-size: 11px;
                }
            }

            VerticalLayout {
                visible: root.tab == 1;
                width: parent.width;
                height: parent.height;
                spacing: 4px;

                Text {
                    text: root.pd-sink;
                    font-weight: 600;
                }

                Text {
                    text: root.pd-lines;
                    opacity: 0.8;
                }

                Text {
                    text: "Contract: " + root.pd-contract;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    CheckBox {
                        text: "Hide GoodCRC";
                        checked <=> root.pd-hide-good-crc;
                        toggled => { root.pd-filter-changed(self.checked); }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: "Clear";
                        clicked => { root.pd-clear(); }
                    }
                }

                ListView {
                    vertical-stretch: 1;
                    for row[index] in root.pd-rows: PdRowView {
                        entry: row;
                        toggled => { root.pd-row-toggled(index); }
                    }
                }
            }
        }
    }
}
